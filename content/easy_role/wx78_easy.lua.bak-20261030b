-- 2025.11.26 YeFeng:饥饿芯片负面反转系统（参考《永不妥协》模组）
-- 装备多个饥饿芯片可以递减食物负面效果，最高可反转为正面效果
-- 1芯片:负面减半 / 2芯片:减至25% / 3芯片:完全抵消 / 4芯片:反转为正面(不妥协模式下8格插槽，可以抵达4级)
local HUNGER_TABLES_2HM = { 0.5, 0.25, 0.00, -0.25 }
local function stats_negate_2hm(inst, health_delta, hunger_delta, sanity_delta)
    -- 获取正确的饥饿芯片数量
    -- 优先使用2hm保存的原始值（兼容《永不妥协》对_hunger_chips的调整）
    local raw_chips = inst._hunger_chips2hm or inst._hunger_chips
    if type(raw_chips) == "table" and raw_chips.value then raw_chips = raw_chips:value() end
    local hunger_chips = tonumber(raw_chips)
    if hunger_chips ~= nil then
        -- 芯片等级按等级累加：1 级芯片 +1，7 级芯片 +7。
        -- 1~3 级逐级降低负面，4 级及以上全部使用第 4 档反转收益。
        local chip_level = math.floor(hunger_chips)
        if chip_level >= 1 then
            local table_level = math.min(chip_level, 4)
            local negmult = HUNGER_TABLES_2HM[table_level]
            if negmult ~= nil then
                -- 只影响负面效果（< 0），正面效果不受影响
                if health_delta < 0 then
                    health_delta = health_delta * negmult
                end
                if sanity_delta < 0 then
                    sanity_delta = sanity_delta * negmult
                end
                if hunger_delta < 0 then
                    hunger_delta = hunger_delta * negmult
                end
            end
        end
    end
    return health_delta, hunger_delta, sanity_delta
end
AddPrefabPostInit("wx78", function(inst)
    if not TheWorld.ismastersim then return end
    -- 延迟执行确保其他模组已初始化完成
    inst:DoTaskInTime(0, function(inst)
        if inst.components.eater ~= nil then
            -- 保存已存在的 custom_stats_mod_fn（兼容《永不妥协》或其他模组）
            local _existing_custom_stats_mod_fn = inst.components.eater.custom_stats_mod_fn
            -- 使用包装模式：先调用已存在的函数，再调用我们的逻辑
            inst.components.eater.custom_stats_mod_fn = function(inst, health_delta, hunger_delta, sanity_delta, ...)
                -- 如果有其他模组的函数，先调用它
