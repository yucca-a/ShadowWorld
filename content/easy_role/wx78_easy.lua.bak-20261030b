    TUNING.SKILLS.WX78.SHADOWDRONE_DEBUFFER_SCAN_RANGE_MAX = TUNING.SKILLS.WX78.SHADOWDRONE_DEBUFFER_SCAN_RANGE_MAX * 2

    local speed = TUNING.SKILLS.WX78.SHADOWDRONE_DEBUFFER_WALKSPEED
    local DEG_45 = 45 * DEGREES
    local WX78_ShadowDrone_BrainCommon = require("brains/wx78_shadowdrone_braincommon")
    local function GetScanTarget(inst)
        local target = inst:GetScanTarget()
        if target and not (target.components.health and target.components.health:IsDead()) then
            return target
        end
    end

    local function GetScanPos(inst)
        local target = GetScanTarget(inst)
        if target then
            local scandist--[[, maxdist]] = inst:CalcScanRange()
            local x1, y1, z1 = target.Transform:GetWorldPosition()
            local theta
            local offs = WX78_ShadowDrone_BrainCommon.GetFormationOffset(inst)
            if offs then
                theta = math.atan2(-offs.z, offs.x)
            else
                local x, y, z = inst.Transform:GetWorldPosition()
                if x == x1 and z == z1 then
                    theta = (inst.Transform:GetRotation() + 180) * DEGREES
                else
                    theta = math.atan2(z - z1, x - x1)
                end
            end
            --Snap to nearest 45 degrees, better matches 8-faced beams
            theta = math.floor(theta / DEG_45 + 0.5) * DEG_45
            return Vector3(x1 + scandist * math.cos(theta), 0, z1 - scandist * math.sin(theta))
        end
    end

    local function UpdatePositionToTarget(inst, dt)
        if not inst then return end
        
        local target_pos = GetScanPos(inst)
        if not target_pos then return end
        
        local current_pos = inst:GetPosition()
        local dx = target_pos.x - current_pos.x
        local dz = target_pos.z - current_pos.z
        local dist = math.sqrt(dx * dx + dz * dz)
        
        if dist < 0.1 then
            if inst.components.locomotor then
                inst.components.locomotor:Stop()
            end
            return
        end
        
        local dir_x = dx / dist
        local dir_z = dz / dist
        
        local move_dist = speed * dt
        
        if dist <= move_dist then
            inst.Transform:SetPosition(target_pos.x, target_pos.y, target_pos.z)
            if inst.components.locomotor then
                inst.components.locomotor:Stop()
            end
            return
        end
        
        local new_x = current_pos.x + dir_x * move_dist
        local new_z = current_pos.z + dir_z * move_dist
        
        inst.Transform:SetPosition(new_x, current_pos.y, new_z)
    end

    AddStategraphPostInit("wx78_shadowdrone_debuffer", function(sg)
        if sg and sg.states and sg.states.scanning and sg.states.scanning.onupdate then
            local oldonupdate = sg.states.scanning.onupdate
            sg.states.scanning.onupdate = function(inst, dt, ...)
                UpdatePositionToTarget(inst, dt)
