-- 更新防水效果的函数
local function UpdateHeatWaterproof(wx)
    if not wx or not wx.components.moisture then return end
    -- 检查是否有激活的热能芯片
    local has_heat_module = false
    if wx.components.upgrademoduleowner then
        for bartype, modules in pairs(wx.components.upgrademoduleowner.module_bars) do
            for _, module in ipairs(modules) do
                if module and module.prefab == "wx78module_heat" and
                    module.components.upgrademodule and module.components.upgrademodule.activated then
                    has_heat_module = true
                    break
                end
            end
        end
    end
    -- 根据是否有热能芯片设置防水效果
    if has_heat_module then
        -- Hook DoDelta函数，完全阻止潮湿度增加
        if not wx.components.moisture._original_DoDelta_heat_waterproof then
            -- 保存原始DoDelta函数
            wx.components.moisture._original_DoDelta_heat_waterproof = wx.components.moisture.DoDelta
            -- 替换为新的DoDelta函数
            wx.components.moisture.DoDelta = function(self, delta, ...)
                -- 只允许负值（干燥），阻止正值（变湿）
                if delta and delta > 0 then
                    delta = 0
                end
                -- 调用原始函数
                if self._original_DoDelta_heat_waterproof then
                    return self._original_DoDelta_heat_waterproof(self, delta, ...)
                end
            end
        end

        -- 立即清除已有的潮湿度
        if wx.components.moisture:GetMoisture() > 0 then
            wx.components.moisture:DoDelta(-wx.components.moisture:GetMoisture())
        end

        wx.wx78_heat_waterproof_active = true
    else
        -- 移除防水效果，恢复原始DoDelta函数
        if wx.wx78_heat_waterproof_active and wx.components.moisture._original_DoDelta_heat_waterproof then
            wx.components.moisture.DoDelta = wx.components.moisture._original_DoDelta_heat_waterproof
            wx.components.moisture._original_DoDelta_heat_waterproof = nil
            wx.wx78_heat_waterproof_active = nil
        end
    end
end
