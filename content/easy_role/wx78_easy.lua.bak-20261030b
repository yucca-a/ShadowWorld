-- 检测是否同时装备Lv2热能和Lv2制冷电路
local function HasTemperatureBalance(wx)
    if not wx or not wx.components.upgrademoduleowner then return false end
    local has_heat_lv2 = false
    local has_cold_lv2 = false
    for bartype, modules in pairs(wx.components.upgrademoduleowner.module_bars) do
        for _, module in ipairs(modules) do
            if module and module.components.upgrademodule and module.components.upgrademodule.activated then
                -- 检查热能电路：必须是Lv2或以上
                if module.prefab == "wx78module_heat" and module.level2hm and module.level2hm:value() >= 2 then
                    has_heat_lv2 = true
                    -- 检查制冷电路：必须是Lv2或以上
                elseif module.prefab == "wx78module_cold" and module.level2hm and module.level2hm:value() >= 2 then
                    has_cold_lv2 = true
                end
            end
            if has_heat_lv2 and has_cold_lv2 then
                return true
            end
        end
    end
    return false
end

-- 更新极限双元领域效果
local function UpdateTemperatureBalance(wx)
    if not wx then return end
    local has_balance = HasTemperatureBalance(wx)
    if has_balance then
        -- 激活极限双元领域状态
        if not wx.temperature_balance_active2hm then
            wx.temperature_balance_active2hm = true
            -- 1. 添加温度恒定任务（每0.5秒修正到10度）
            if wx.temperature_balance_task2hm then
                wx.temperature_balance_task2hm:Cancel()
            end
            wx.temperature_balance_task2hm = wx:DoPeriodicTask(0.5, function(inst)
                if inst.components.temperature then
                    local target_temp = 10
                    local current_temp = inst.components.temperature.current
                    if math.abs(target_temp - current_temp) > 0.1 then
                        inst.components.temperature:SetTemperature(target_temp)
                    end
                end
            end)
            -- 2. 添加双向温度光环
            if not wx.components.heater then
                wx:AddComponent("heater")
            end
            wx.components.heater.heat = 80
            wx.components.heater.carriedheat = -80
            wx.components.heater:SetThermics(true, true)
