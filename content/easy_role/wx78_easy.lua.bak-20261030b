                    health_delta, hunger_delta, sanity_delta = _existing_custom_stats_mod_fn(inst, health_delta,
                        hunger_delta, sanity_delta, ...)
                end
                -- 然后应用我们的负面反转逻辑
                return stats_negate_2hm(inst, health_delta, hunger_delta, sanity_delta)
            end
        end
    end)
end)

